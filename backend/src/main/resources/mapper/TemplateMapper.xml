<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaoying.materialstudio.mapper.TemplateMapper">

    <resultMap id="templateMap" type="com.xiaoying.materialstudio.template.Template">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="category" property="category"/>
        <result column="cover_url" property="coverUrl"/>
        <result column="description" property="description"/>
        <result column="required_image_count" property="requiredImageCount"/>
        <result column="accepted_mime_types" property="acceptedMimeTypes"/>
        <result column="max_file_size_bytes" property="maxFileSizeBytes"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="enabled" property="enabled"/>
    </resultMap>

    <sql id="templateColumns">
        id, title, category, cover_url, description, required_image_count,
        accepted_mime_types, max_file_size_bytes, sort_order, enabled
    </sql>

    <select id="findAll" resultMap="templateMap">
        SELECT <include refid="templateColumns"/>
        FROM template
        WHERE enabled = 1
        <if test="category != null and category != ''">
            AND category = #{category}
        </if>
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findById" resultMap="templateMap">
        SELECT <include refid="templateColumns"/>
        FROM template
        WHERE id = #{id} AND enabled = 1
    </select>

    <select id="findCategories" resultType="java.lang.String">
        SELECT category
        FROM template
        WHERE enabled = 1
        GROUP BY category
        ORDER BY MIN(sort_order) ASC
    </select>

</mapper>
