<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaoying.materialstudio.mapper.UploadAssetMapper">

    <resultMap id="uploadAssetMap" type="com.xiaoying.materialstudio.asset.UploadAsset">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="template_id" property="templateId"/>
        <result column="original_name" property="originalName"/>
        <result column="stored_path" property="storedPath"/>
        <result column="mime_type" property="mimeType"/>
        <result column="size_bytes" property="sizeBytes"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="assetColumns">
        id, user_id, template_id, original_name, stored_path, mime_type, size_bytes, created_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO upload_asset (user_id, template_id, original_name, stored_path, mime_type, size_bytes)
        VALUES (#{userId}, #{templateId}, #{originalName}, #{storedPath}, #{mimeType}, #{sizeBytes})
    </insert>

    <select id="findByIdAndUserId" resultMap="uploadAssetMap">
        SELECT <include refid="assetColumns"/>
        FROM upload_asset
        WHERE id = #{id} AND user_id = #{userId}
    </select>

    <select id="findByIdsAndUserId" resultMap="uploadAssetMap">
        SELECT <include refid="assetColumns"/>
        FROM upload_asset
        WHERE user_id = #{userId}
          AND id IN
        <foreach collection="ids" item="assetId" open="(" separator="," close=")">
            #{assetId}
        </foreach>
    </select>

    <delete id="deleteByIdAndUserId">
        DELETE FROM upload_asset WHERE id = #{id} AND user_id = #{userId}
    </delete>

</mapper>
