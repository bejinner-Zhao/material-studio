# 复制为 .env 后按需修改；以下均为本地演示用的非敏感默认值，不要用于生产环境

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root_password
DB_NAME=material_studio
DB_USER=app
DB_PASSWORD=app_password
DB_PORT=3306

# ---------- 后端 ----------
BACKEND_PORT=8080

# ---------- 制作过程模拟 ----------
# 指定阶段必定失败：NONE / MATERIAL_CHECK / GENERATING / FINALIZING
SIMULATOR_FAIL_STAGE=NONE
# 每个阶段的模拟耗时（毫秒）
SIMULATOR_STAGE_DELAY_MS=3000
# 同时执行的任务数，其余在库中排队
SIMULATOR_MAX_CONCURRENT=2

# ---------- 前端 ----------
FRONTEND_PORT=3000
# Next.js rewrites 把 /api/**、/files/**、/demo/** 转发到这里（构建时写入产物）
BACKEND_ORIGIN=http://backend:8080
